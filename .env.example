# Required: OpenAI API key, used for both chat completions and embeddings.
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Kaggle dataset config (kagglehub). Only needed if data/arxiv_ai.csv is
# missing and must be downloaded fresh -- auth via a ~/.kaggle/kaggle.json
# (https://www.kaggle.com/docs/api#authentication) or these two env vars:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
KAGGLE_DATASET=yasirabdaali/arxivorg-ai-research-papers-dataset
KAGGLE_FILE_PATH=arxiv_ai.csv

DATA_DIR=data
RAW_CSV_FILENAME=arxiv_ai.csv
ARTIFACTS_DIR=artifacts

CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

HYBRID_CANDIDATE_K=50
RERANK_TOP_K=5
RRF_K=60

# Elasticsearch -- required for the default retrieval strategy below. Start
# it with: docker compose up -d. Not started automatically by the app.
ES_URL=http://localhost:9200
ES_API_KEY=
ES_INDEX_NAME=arxiv_papers

# One of: hybrid_rerank, hybrid_only, elasticsearch_rrf. elasticsearch_rrf
# won the 200-sample comparison in notebooks/retrieval_evaluation.py
# (composite score 0.763 vs 0.663 for hybrid_rerank) and is the app default.
RETRIEVAL_STRATEGY=elasticsearch_rrf

EMBEDDING_BATCH_SIZE=200

API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
