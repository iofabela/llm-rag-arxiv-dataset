# Required: OpenAI API key, used for both chat completions and embeddings.
OPENAI_API_KEY=

# Optional model overrides (defaults shown)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Kaggle dataset config (kagglehub). Only needed if data/arxiv_ai.csv is
# missing and must be downloaded fresh -- auth via a ~/.kaggle/kaggle.json
# (https://www.kaggle.com/docs/api#authentication) or these two env vars:
# KAGGLE_USERNAME=
# KAGGLE_KEY=
KAGGLE_DATASET=yasirabdaali/arxivorg-ai-research-papers-dataset
KAGGLE_FILE_PATH=arxiv_ai.csv

DATA_DIR=data
RAW_CSV_FILENAME=arxiv_ai.csv
ARTIFACTS_DIR=artifacts

# dlt destination. When this file exists, the RAG loader reads this table
# before falling back to DATA_DIR/RAW_CSV_FILENAME.
DLT_DATABASE_PATH=data/arxiv_papers.duckdb
DLT_PIPELINES_DIR=.dlt/pipelines
DLT_DATASET_NAME=arxiv_data
DLT_RESOURCE_NAME=arxiv_papers

# One of: hybrid_rerank (recommended), hybrid_only OR elasticsearch_rrf
RETRIEVAL_STRATEGY=hybrid_rerank

CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Candidate pool size for hybrid search (hybrid_rerank / hybrid_only);
# a larger pool gives the cross-encoder rerank more candidates to pull from.
HYBRID_CANDIDATE_K=100
RERANK_TOP_K=5
RRF_K=60

# Elasticsearch -- only required for the elasticsearch_rrf strategy. Start it
# with: docker compose up -d. Not started automatically by the app.
ES_URL=http://localhost:9200
ES_API_KEY=
ES_INDEX_NAME=arxiv_papers

EMBEDDING_BATCH_SIZE=200

API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# Postgres -- stores conversations + user feedback (chat thumbs up/down),
# read by the Grafana dashboard. Start with: docker compose up -d rag-postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arxiv_rag
POSTGRES_USER=arxiv_rag
POSTGRES_PASSWORD=arxiv_rag

# Grafana -- dashboard at http://localhost:3000, provisioned automatically
# from grafana/provisioning/. Start with: docker compose up -d grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
